# ─────────────────────────────────────────────────────────────
# Configuration Firebase
#
# Toutes ces valeurs sont destinées au navigateur : elles ne sont pas
# secrètes. Ce qui protège les données, ce sont les règles Firestore
# (firestore.rules), pas la confidentialité de ces clés.
#
# Où les trouver : Console Firebase › Paramètres du projet ›
# Vos applications › Web › Configuration du SDK
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Cloudinary — dépôt des images du back-office
#
# Le site est statique : une image déposée depuis l'administration part
# directement du navigateur vers Cloudinary. Ces deux valeurs sont
# publiques ; c'est le préréglage d'envoi, configuré côté Cloudinary
# (formats acceptés, taille maximale, dossier), qui fait la limite.
#
# Où les trouver : console Cloudinary › Settings › Upload ›
# « Upload presets » (créer un préréglage en mode Unsigned).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# URL canonique du site (sans slash final) — sert au sitemap et aux metadata
NEXT_PUBLIC_SITE_URL=https://eco2bat.fr

# ─────────────────────────────────────────────────────────────
# Émulateurs (développement local, facultatif)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
